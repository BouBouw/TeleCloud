NODE_ENV=production
PORT=4000

# Base de données PostgreSQL (même VPS)
DATABASE_URL="postgresql://vibot:CHANGE_ME_DB_PASSWORD@localhost:5432/vibot?schema=public"

# JWT — générer avec : openssl rand -hex 32
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Stockage fichiers
STORAGE_PATH=/var/www/vibot/server/storage
MAX_STORAGE_BYTES=10737418240

# Docker (pour les bots Telegram — optionnel)
DOCKER_SOCKET=/var/run/docker.sock
BOT_IMAGE_NAME=vibot-bot:latest

# CORS — URL publique du frontend
CORS_ORIGIN=https://vibot.cloud
