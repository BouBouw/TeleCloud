NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://vibot:vibot@localhost:5432/vibot?schema=public"
JWT_SECRET=your_super_secret_jwt_key_change_in_production_minimum_32_chars
JWT_EXPIRES_IN=7d
