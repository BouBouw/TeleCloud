# vibot-tunnel — local YouTube download tunnel

# URL of the VPS (no trailing slash)
VPS_URL=https://vibot.cloud

# Shared secret — must match TUNNEL_SECRET on the server
TUNNEL_SECRET=change_me_to_a_random_secret

# (Optional) force a specific browser for cookie extraction.
# If not set, the tunnel will auto-detect in order: chrome, edge, brave, firefox, opera.
# Valid values: chrome, chromium, edge, brave, firefox, opera, safari, vivaldi, whale
PREFERRED_BROWSER=chrome

# (Optional) temp directory for downloads (defaults to OS temp dir)
# TEMP_DIR=C:\Temp\vibot
